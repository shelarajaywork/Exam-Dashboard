# Google Drive API Configuration
# Option 1: Path to your Google Cloud Service Account JSON key file
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Option 2: Alternatively, the raw JSON content of the service account (useful for Streamlit Cloud secrets)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# The ID of the Root Google Drive folder containing your data folders
# (Extract from the Drive URL: drive.google.com/drive/folders/YOUR_FOLDER_ID)
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_parent_folder_id_here
